+/// Reads current manifests and the schema-v1/v2 package records emitted by
+/// older Sage builders. Legacy records used TOML strings for `release` and
+/// called the amd64 architecture `x86_64`; normalizing them here lets a fresh
+/// Sage bootstrap consume an explicitly preserved seed pool without treating
+/// that pool as current installed state.
+fn parse_manifest(bytes: &[u8]) -> Result<(PackageManifest, bool), ArchiveError> {
+    let text = std::str::from_utf8(bytes)
+        .map_err(|_| ArchiveError::InvalidMetadata("manifest is not UTF-8".into()))?;
+    if let Ok(manifest) = toml::from_str::<PackageManifest>(text) {
+        sage_core::validate_schema(manifest.schema_version)
+            .map_err(|error| ArchiveError::InvalidMetadata(error.to_string()))?;
+        sage_core::validate_spdx_expression(&manifest.license)
+            .map_err(|error| ArchiveError::InvalidMetadata(error.to_string()))?;
+        return Ok((manifest, false));
+    }
+
+    // Sage 0.3 embedded a second, attestation-only package table in a
+    // triple-quoted field. Parse the first package record on its own so the
+    // old attestation cannot make the TOML document appear duplicated.
+    let legacy_text = text
+        .split_once("\nattestation_toml = \"\"\"")
+        .map_or(text, |(prefix, _)| prefix);
+    let legacy = match toml::from_str::<LegacyPackage>(legacy_text) {
+        Ok(package) => package,
+        Err(_) => {
+            let envelope = toml::from_str::<LegacyEnvelope>(legacy_text)
+                .map_err(|error| ArchiveError::InvalidMetadata(error.to_string()))?;
+            let mut package = envelope.package;
+            let mut dependencies = envelope.dependencies;
+            let mut provides = envelope.provides;
+            let mut conflicts = envelope.conflicts;
+            for producer in envelope.build_producers {
+                if dependencies.is_empty() {
+                    dependencies = producer.dependencies;
+                }
+                if provides.is_empty() {
+                    provides = producer.provides;
+                }
+                if conflicts.is_empty() {
+                    conflicts = producer.conflicts;
+                }
+            }
+            // Sage 0.3 stored the identity in `[package]` but emitted the
+            // dependency/provider arrays in the build-producer table. Merge
+            // those arrays so preserved seed packages remain usable.
+            if package.dependencies.is_empty() {
+                package.dependencies = dependencies;
+            }
+            if package.provides.is_empty() {
+                package.provides = provides;
+            }
+            if package.conflicts.is_empty() {
+                package.conflicts = conflicts;
+            }
+            package
+        }
+    };
+    let release = legacy
+        .release
+        .as_u32()
+        .ok_or_else(|| ArchiveError::InvalidMetadata("invalid package release".into()))?;
+    let dependencies = legacy
+        .dependencies
+        .into_iter()
+        .map(|value| {
+            value.parse().map_err(|error: sage_core::CoreError| {
+                ArchiveError::InvalidMetadata(error.to_string())
+            })
+        })
+        .collect::<Result<Vec<_>, _>>()?;
+    let license = if sage_core::validate_spdx_expression(&legacy.license).is_ok() {
+        legacy.license
+    } else {
+        // Sage 0.3 accepted SPDX-like project labels such as `bzip2-1.0.6`
+        // and `Public-domain`. Keep those archives usable as bootstrap input
+        // without allowing non-SPDX text into the current metadata model.
+        "LicenseRef-Sage-Legacy".into()
+    };
+    let channel = legacy.channel.clone();
+    let slot = legacy.slot.or_else(|| match channel.as_str() {
+        "toolchain/gcc:16" => Some("16".into()),
+        "toolchain/llvm:22" => Some("22.1.8".into()),
+        "runtime/python:3.14" => Some("3.14".into()),
+        _ => None,
+    });
+    let mut provides = legacy.provides;
+    // The preserved Sage 0.3 pool used `zlib` for the runtime package; the
+    // current recipe graph names the same ABI provider `zlib-libs`.
+    if legacy.name == "zlib" && !provides.iter().any(|value| value == "zlib-libs") {
+        provides.push("zlib-libs".into());
+    }
+    Ok((
+        PackageManifest {
+            schema_version: sage_core::SCHEMA_VERSION,
+            name: legacy.name,
+            slot: slot.unwrap_or_else(|| sage_core::DEFAULT_SLOT.into()),
+            version: legacy.version,
+            release,
+            epoch: legacy.epoch,
+            arch: if legacy.arch == "x86_64" {
+                "amd64".into()
+            } else {
+                legacy.arch
+            },
+            channel,
+            description: legacy.description,
+            license,
+            dependencies,
+            provides,
+            conflicts: legacy.conflicts,
+            features: legacy.features,
+            installed_size: legacy.installed_size,
+            build_time: legacy.build_time,
+            managed_build_tools: Vec::new(),
+        },
+        true,
+    ))
+}
