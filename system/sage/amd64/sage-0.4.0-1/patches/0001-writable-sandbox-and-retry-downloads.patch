+/// Converts the Sage 0.3 `files.idx` row layout to the current file record.
+/// Directory rows are deliberately omitted because tar directory entries are
+/// created while extracting the indexed payload files.
+fn parse_legacy_file_record(
+    kind: &str,
+    fields: Vec<&str>,
+    line: &str,
+) -> Result<Option<FileRecord>, ArchiveError> {
+    if kind == "dir" {
+        return Ok(None);
+    }
+    let (mode, size, hash, path, target) = match fields.as_slice() {
+        // Sage 0.3 v1: mode, size, sha256, path, target
+        [mode, size, hash, path, target] => (*mode, *size, *hash, *path, *target),
+        // Sage 0.3 v2: mode, uid, gid, caps, size, sha256, path, target
+        [mode, _uid, _gid, _caps, size, hash, path, target] => {
+            (*mode, *size, *hash, *path, *target)
+        }
+        _ => {
+            return Err(ArchiveError::InvalidMetadata(format!(
+                "invalid legacy files.idx row '{line}'"
+            )))
+        }
+    };
+    let path = clean_archive_path(Path::new(path))?;
+    let mode = u32::from_str_radix(mode, 8)
+        .map_err(|_| ArchiveError::InvalidMetadata(format!("invalid mode in '{line}'")))?;
+    if kind == "file" {
+        let size = size
+            .parse()
+            .map_err(|_| ArchiveError::InvalidMetadata(format!("invalid size in '{line}'")))?;
+        let sha256 = if hash == "-" && size == 0 {
+            hex::encode(Sha256::digest([]))
+        } else if hash.len() == 64 && hash.bytes().all(|byte| byte.is_ascii_hexdigit()) {
+            hash.to_ascii_lowercase()
+        } else {
+            return Err(ArchiveError::InvalidMetadata(format!(
+                "invalid SHA-256 in '{line}'"
+            )));
+        };
+        return Ok(Some(FileRecord {
+            path,
+            mode,
+            size,
+            sha256,
+        }));
+    }
+    if kind == "hardlink" {
+        if target == "-" || target.is_empty() {
+            return Err(ArchiveError::InvalidMetadata(format!(
+                "unsupported legacy files.idx row '{line}'"
+            )));
+        }
+        return Ok(Some(FileRecord {
+            path,
+            mode,
+            size: 0,
+            sha256: String::new(),
+        }));
+    }
+    if !matches!(kind, "link" | "symlink") || target == "-" || target.is_empty() {
+        return Err(ArchiveError::InvalidMetadata(format!(
+            "unsupported legacy files.idx row '{line}'"
+        )));
+    }
+    let target_bytes = target.as_bytes();
+    Ok(Some(FileRecord {
+        path,
+        mode,
+        size: target_bytes.len() as u64,
+        sha256: hex::encode(Sha256::digest(target_bytes)),
+    }))
+}
