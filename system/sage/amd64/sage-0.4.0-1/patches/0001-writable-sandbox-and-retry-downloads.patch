+fn write_verified_hardlink(
+    root: &OwnedFd,
+    path: &Path,
+    _record: &FileRecord,
+    target: &Path,
+) -> Result<(), ArchiveError> {
+    if target.as_os_str().is_empty()
+        || target
+            .components()
+            .any(|component| matches!(component, Component::ParentDir | Component::RootDir))
+    {
+        return Err(ArchiveError::UnsafePath(target.display().to_string()));
+    }
+    let source_dir = ensure_directory(root, target.parent().unwrap_or(Path::new("")))?;
+    let destination_dir = ensure_directory(root, path.parent().unwrap_or(Path::new("")))?;
+    let source_name = target
+        .file_name()
+        .ok_or_else(|| ArchiveError::UnsafePath(target.display().to_string()))?;
+    let destination_name = path
+        .file_name()
+        .ok_or_else(|| ArchiveError::UnsafePath(path.display().to_string()))?;
+    linkat(
+        Some(source_dir.as_raw_fd()),
+        source_name,
+        Some(destination_dir.as_raw_fd()),
+        destination_name,
+        LinkatFlags::NoSymlinkFollow,
+    )?;
+    Ok(())
+}
