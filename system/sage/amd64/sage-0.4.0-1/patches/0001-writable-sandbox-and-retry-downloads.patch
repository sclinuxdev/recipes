+/// to known legacy names; arbitrary channel strings are never rewritten.
+fn legacy_channel_alias(channel: &str, aliases: &BTreeMap<String, String>) -> Option<String> {
+    let alias = match channel {
+        "toolchain/gcc:16" => "gcc16",
+        "toolchain/llvm:22" => "llvm22",
+        "runtime/python:3.14" => "python3.14",
+        "toolchain/perl:5.44" => "system",
+        _ => return None,
+    };
+    aliases.get(alias).cloned()
